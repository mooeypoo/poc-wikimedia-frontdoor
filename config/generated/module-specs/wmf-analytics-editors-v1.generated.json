	"host": "wikimedia.org",
	"info": {
		"contact": {},
		"description": "Editor Analytics provides data about the number of editors and newly registered users of Wikimedia projects.\nData provided by this API is available under the [CC0 1.0 license](https://creativecommons.org/publicdomain/zero/1.0/).",
		"termsOfService": "https://foundation.wikimedia.org/wiki/Special:MyLanguage/Policy:Terms_of_Use",
		"title": "Wikimedia Editor Analytics",
		"version": "1"
	},
	"paths": {
		"/editors/aggregate/{project}/{editor-type}/{page-type}/{activity-level}/{granularity}/{start}/{end}": {
			"get": {
				"description": "Returns a time series of numbers of editors on a Wikimedia project.",
				"parameters": [
					{
						"description": "Domain and subdomain of a Wikimedia project",
						"example": "en.wikipedia.org",
						"in": "path",
						"name": "project",
						"required": true,
						"type": "string"
					},
					{
						"description": "Type of editor. `group-bot` for registered accounts belonging to the bot group; `name-bot` for registered accounts with bot-like names",
						"enum": [
							"all-editor-types",
							"anonymous",
							"group-bot",
							"name-bot",
							"user"
						],
						"example": "all-editor-types",
						"in": "path",
						"name": "editor-type",
						"required": true,
						"type": "string"
					},
					{
						"description": "Type of page",
						"enum": [
							"all-page-types",
							"content",
							"non-content"
						],
						"example": "all-page-types",
						"in": "path",
						"name": "page-type",
						"required": true,
						"type": "string"
					},
					{
						"description": "Editor activity range",
						"enum": [
							"all-activity-levels",
							"1..4-edits",
							"5..24-edits",
							"25..99-edits",
							"100..-edits"
						],
						"example": "all-activity-levels",
						"in": "path",
						"name": "activity-level",
						"required": true,
						"type": "string"
					},
					{
						"description": "Time interval between data points",
						"enum": [
							"daily",
							"monthly"
						],
						"example": "monthly",
						"in": "path",
						"name": "granularity",
						"required": true,
						"type": "string"
					},
					{
						"description": "First day to include in YYYYMMDD format",
						"example": "20230101",
						"in": "path",
						"name": "start",
						"required": true,
						"type": "string"
					},
					{
						"description": "Last day to include in YYYYMMDD format",
						"example": "20240101",
						"in": "path",
						"name": "end",
						"required": true,
						"type": "string"
					}
				],
				"produces": [
					"application/json"
				],
				"responses": {
					"200": {
						"description": "OK",
						"schema": {
							"$ref": "#/definitions/entities.AggregateResponse"
						}
					},
					"400": {
						"description": "Bad request",
						"schema": {
							"properties": {
								"detail": {
									"type": "string"
								},
								"method": {
									"type": "string"
								},
								"status": {
									"type": "integer"
								},
								"title": {
									"type": "string"
								},
								"type": {
									"type": "string"
								},
								"uri": {
									"type": "string"
								}
							},
							"type": "object"
						}
					},
					"404": {
						"description": "Not found",
						"schema": {
							"properties": {
								"detail": {
									"type": "string"
								},
								"method": {
									"type": "string"
								},
								"status": {
									"type": "integer"
								},
								"title": {
									"type": "string"
								},
								"type": {
