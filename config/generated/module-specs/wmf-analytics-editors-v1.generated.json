								}
							},
							"type": "object"
						}
					}
				},
				"summary": "Get number of editors"
			}
		},
		"/editors/top-by-absolute-bytes-difference/{project}/{editor-type}/{page-type}/{year}/{month}/{day}": {
			"get": {
				"description": "Lists the 100 most-active editors on a Wikimedia project, ordered by the absolute change in page length introduced by their edits, in bytes. For example, if an editor adds 5 bytes and removes 10 bytes, the absolute change is 15 bytes.",
				"parameters": [
					{
						"description": "Domain and subdomain of a Wikimedia project. For all projects, use `all-projects`. For data grouped by project family, use `all-[family]-projects`; for example, `all-wikipedia-projects`",
						"example": "en.wikipedia.org",
						"in": "path",
						"name": "project",
						"required": true,
						"type": "string"
					},
					{
						"description": "Type of editor. `group-bot` for registered accounts belonging to the bot group; `name-bot` for registered accounts with bot-like names",
						"enum": [
							"all-editor-types",
							"anonymous",
							"group-bot",
							"name-bot",
							"user"
						],
						"example": "all-editor-types",
						"in": "path",
						"name": "editor-type",
						"required": true,
						"type": "string"
					},
					{
						"description": "Type of page",
						"enum": [
							"all-page-types",
							"content",
							"non-content"
						],
						"example": "all-page-types",
						"in": "path",
						"name": "page-type",
						"required": true,
						"type": "string"
					},
					{
						"description": "Year in YYYY format",
						"example": "2023",
						"in": "path",
						"name": "year",
						"required": true,
						"type": "string"
					},
					{
						"description": "Month in MM format",
						"example": "01",
						"in": "path",
						"name": "month",
						"required": true,
						"type": "string"
					},
					{
						"description": "Day in DD format, or `all-days`",
						"example": "02",
						"in": "path",
						"name": "day",
						"required": true,
						"type": "string"
					}
				],
				"produces": [
					"application/json"
				],
				"responses": {
					"200": {
						"description": "OK",
						"schema": {
							"$ref": "#/definitions/entities.TopByAbsoluteBytesDifferenceResponse"
						}
					},
					"400": {
						"description": "Bad request",
						"schema": {
							"properties": {
								"detail": {
									"type": "string"
								},
								"method": {
									"type": "string"
								},
								"status": {
									"type": "integer"
								},
								"title": {
									"type": "string"
								},
								"type": {
									"type": "string"
								},
								"uri": {
									"type": "string"
								}
							},
							"type": "object"
						}
					},
					"404": {
						"description": "Not found",
						"schema": {
							"properties": {
								"detail": {
									"type": "string"
								},
								"method": {
									"type": "string"
								},
								"status": {
									"type": "integer"
								},
								"title": {
									"type": "string"
								},
								"type": {
									"type": "string"
								},
								"uri": {
