		"/video_plays/v3/aggregate/{referer}/{agent}/{granularity}/{start}/{end}": {
			"get": {
				"description": "Returns a time series of video play counts aggregated across all files. This is an Analytics API v3 endpoint: all params and response keys use snake_case, end date parameters are exclusive, and response format has a context object and items array.",
				"parameters": [
					{
						"description": "Origin of the request. Can be a domain of a Wikimedia project, or any of the allowed values: `all-referers`, `internal`, `external`, `search-engine`, `unknown`, or `none`",
						"example": "all-referers",
