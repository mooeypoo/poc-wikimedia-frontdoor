						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				],
				"summary": "Retrieve a summary of the user's association with suggested investigation cases"
			}
		},
		"/temporaryaccount/{name}": {
			"post": {
				"description": "Returns IP addresses associated with a temporary account name.",
				"operationId": "postGetIpAddressesForTemporaryAccount",
				"parameters": [
					{
						"description": "Temporary account name to query",
						"example": "~2026-10001",
						"in": "path",
						"name": "name",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"description": "Maximum number of IP addresses to return",
						"example": 50,
						"in": "query",
						"name": "limit",
						"required": false,
						"schema": {
							"default": 5000,
							"type": "integer"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"example": {
								"token": "+\\"
							},
							"schema": {
								"properties": {
									"token": {
										"default": "",
										"description": "CSRF token",
										"example": "+\\",
										"type": "string"
									}
								},
								"type": "object"
							}
						}
					},
					"description": "Request body containing the CSRF token.",
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"description": "Response containing IP addresses associated with the temporary account name",
									"example": {
										"autoReveal": false,
										"ips": [
											"192.0.2.1",
											"2001:db8::1"
										]
									},
									"properties": {
										"autoReveal": {
											"description": "Whether auto-reveal of temporary accounts is enabled for the performer",
											"type": "boolean"
										},
										"ips": {
											"description": "List of IP addresses used by the temporary account",
											"items": {
												"description": "IP address in IPv4 or IPv6 format",
												"type": "string"
											},
											"type": "array"
										}
									},
									"required": [
										"ips"
									],
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				],
				"summary": "Get IP addresses for temporary account"
			}
		},
