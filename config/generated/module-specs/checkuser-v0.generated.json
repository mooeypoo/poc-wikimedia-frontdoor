	},
	"openapi": "3.0.0",
	"paths": {
		"/batch-temporaryaccount": {
			"post": {
				"description": "Returns IP addresses mapped to a list of temporary user names, and log/abuse log IDs.",
				"operationId": "postGetIpAddressesForTemporaryAccountBatch",
				"parameters": [],
				"requestBody": {
					"content": {
						"application/json": {
							"example": {
								"token": "+\\",
								"users": {
									"~2026-10001": {
										"abuseLogIds": [],
										"lastUsedIp": true,
										"logIds": [
											"789"
										],
										"revIds": [
											"123",
											"456"
										]
									}
								}
							},
							"schema": {
								"properties": {
									"token": {
										"default": "",
										"description": "CSRF token",
										"example": "+\\",
										"type": "string"
									},
									"users": {
										"additionalProperties": {
											"additionalProperties": false,
											"properties": {
												"abuseLogIds": {
													"description": "List of AbuseFilter log IDs to look up",
													"items": {
														"description": "AbuseFilter log ID",
														"type": "string"
													},
													"type": "array"
												},
												"lastUsedIp": {
													"description": "Whether to include the last used IP in the response",
													"type": "boolean"
												},
												"logIds": {
													"description": "List of log IDs to look up",
													"items": {
														"description": "Log ID",
														"type": "string"
													},
													"type": "array"
												},
												"revIds": {
													"description": "List of revision IDs to look up",
													"items": {
														"description": "Revision ID",
														"type": "string"
													},
													"type": "array"
												}
											},
											"required": [
												"revIds",
												"logIds",
												"lastUsedIp"
											],
											"type": "object"
										},
										"description": "Map of temporary usernames to their requested revision/log/abuse filter IDs",
										"example": {
											"~2026-10001": {
												"abuseLogIds": [],
												"lastUsedIp": true,
												"logIds": [
													"789"
												],
												"revIds": [
													"123",
													"456"
												]
											}
										},
										"type": "object"
									}
								},
								"required": [
									"users"
								],
								"type": "object"
							}
						}
					},
					"description": "Request body containing a map of temporary usernames to their requested revision/log/abuse filter IDs",
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"additionalProperties": {
										"description": "IP data associated with a temporary account",
										"properties": {
											"abuseLogIps": {
												"additionalProperties": {
													"description": "IP address or null",
													"nullable": true,
													"type": "string"
												},
												"description": "Map of AbuseFilter log IDs to IP addresses, or null when no AbuseFilter log IDs were requested. The map omits expired IDs.",
												"nullable": true,
												"type": "object"
											},
											"lastUsedIp": {
												"description": "Last used IP address for the user, if requested",
												"nullable": true,
												"type": "string"
											},
											"logIps": {
												"additionalProperties": {
													"description": "IP address or null",
													"nullable": true,
													"type": "string"
												},
												"description": "Map of log IDs to IP addresses, or null when no log IDs were requested. The map omits expired IDs.",
												"nullable": true,
												"type": "object"
											},
											"revIps": {
												"additionalProperties": {
													"description": "IP address or null",
													"nullable": true,
													"type": "string"
												},
												"description": "Map of revision IDs to IP addresses, or null when no revision IDs were requested. The map omits expired IDs.",
												"nullable": true,
												"type": "object"
											}
										},
										"required": [
											"revIps",
											"logIps",
											"lastUsedIp"
										],
										"type": "object"
									},
									"description": "Response containing IP addresses mapped to target temporary accounts and requested IDs",
									"example": {
										"~2026-10001": {
											"abuseLogIps": [],
											"lastUsedIp": "192.0.2.1",
											"logIps": {
												"789": "2001:db8::1"
											},
											"revIps": {
												"123": "192.0.2.1",
												"456": "192.0.2.1"
											}
										},
										"autoReveal": false
									},
									"properties": {
										"autoReveal": {
											"description": "Whether auto-reveal of temporary accounts is enabled for the performer",
											"type": "boolean"
										}
									},
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				],
				"summary": "Get IP addresses for temporary account batch"
			}
		},
		"/connectedtemporaryaccounts/{name}": {
			"post": {
				"description": "Returns other temporary accounts that have edited from the same IPs as a given temporary account.",
				"operationId": "postGetConnectedTemporaryAccounts",
				"parameters": [
					{
						"description": "Temporary account name to query",
						"example": "~2026-10001",
						"in": "path",
						"name": "name",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"example": {
								"token": "+\\"
							},
							"schema": {
								"properties": {
									"token": {
										"default": "",
										"description": "CSRF token",
										"example": "+\\",
										"type": "string"
									}
								},
								"type": "object"
							}
						}
					},
					"description": "Request body containing the CSRF token.",
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"description": "Response containing temporary accounts that have edited from the same IPs as the target temporary account",
									"example": {
										"autoReveal": false,
										"connectedAccounts": [
											"~2026-12345",
											"~2026-67890"
										],
										"ipsUsedCount": 2
									},
									"properties": {
										"autoReveal": {
											"description": "Whether auto-reveal of temporary accounts is enabled for the performer",
											"type": "boolean"
										},
										"connectedAccounts": {
											"description": "List of connected temporary account names",
											"items": {
												"description": "Temporary account name",
												"type": "string"
											},
											"type": "array"
										},
										"ipsUsedCount": {
											"description": "Number of IP addresses used by the target temporary account",
											"type": "integer"
										}
									},
									"required": [
										"connectedAccounts",
										"ipsUsedCount"
									],
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				],
				"summary": "Get connected temporary accounts"
			}
		},
		"/suggestedinvestigations/case/{caseId}/update": {
			"post": {
				"description": "Updates the status and reason of a suggested investigation case.",
				"operationId": "postUpdateSuggestedInvestigationCaseStatusAndReason",
				"parameters": [
					{
						"description": "Unique identifier of the suggested investigation case",
						"example": 123,
						"in": "path",
						"name": "caseId",
						"required": true,
						"schema": {
							"type": "integer"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"example": {
								"reason": "Resolved after investigation.",
								"status": "resolved",
								"token": "+\\"
							},
							"schema": {
								"properties": {
									"reason": {
										"default": "",
										"description": "Reason for updating the case status",
										"example": "Resolved after investigation.",
										"type": "string"
									},
									"status": {
										"description": "New status to apply to the case (open, resolved, or invalid)",
										"enum": [
											"open",
											"resolved",
											"invalid"
										],
										"example": "resolved",
										"type": "string"
									},
									"token": {
										"default": "",
										"description": "CSRF token",
										"example": "+\\",
										"type": "string"
									}
								},
								"required": [
									"status"
								],
								"type": "object"
							}
						}
					},
					"description": "Request body to update the status of a suggested investigation case",
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"description": "Response containing details of the updated suggested investigation case",
									"example": {
										"caseId": 123,
										"formattedReason": "Resolved by Admin: Resolved after investigation.",
										"reason": "Resolved after investigation.",
										"status": "resolved"
									},
									"properties": {
										"caseId": {
											"description": "Unique identifier of the case",
											"type": "integer"
										},
										"formattedReason": {
											"description": "Formatted reason status message for display",
											"type": "string"
										},
										"reason": {
											"description": "Reason for updating the case status",
											"type": "string"
										},
										"status": {
											"description": "New status of the case",
											"type": "string"
										}
									},
									"required": [
										"caseId",
										"status",
										"reason",
										"formattedReason"
									],
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				],
				"summary": "Update suggested investigation case status and reason"
			}
		},
