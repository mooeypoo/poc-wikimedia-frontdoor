		"/useragent-clienthints/{type}/{id}": {
			"post": {
				"description": "Creates user agent client hints data for a given revision or log event.",
				"operationId": "postCreateUserAgentClientHints",
				"parameters": [
					{
						"description": "Type of event to log, namely revision or privatelog",
						"example": "revision",
						"in": "path",
						"name": "type",
						"required": true,
						"schema": {
							"enum": [
								"revision",
								"privatelog"
							],
							"type": "string"
						}
					},
					{
						"description": "Unique identifier of the revision or private log event",
						"example": 12345,
						"in": "path",
						"name": "id",
						"required": true,
						"schema": {
							"type": "integer"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"example": {
								"architecture": "x86",
								"bitness": "64",
								"brands": [
									{
										"brand": "Not/A)Brand",
										"version": "99"
									},
									{
										"brand": "Chromium",
										"version": "100"
									},
									{
										"brand": "Google Chrome",
										"version": "100"
									}
								],
								"fullVersionList": [
									{
										"brand": "Not/A)Brand",
										"version": "99.0.0.0"
									},
									{
										"brand": "Chromium",
										"version": "100.0.4896.75"
									},
									{
										"brand": "Google Chrome",
										"version": "100.0.4896.75"
									}
								],
								"mobile": false,
								"model": "OnePlus 9",
								"platform": "Windows",
								"platformVersion": "10.0.0",
								"token": "+\\",
								"uaFullVersion": "100.0.4896.75"
							},
							"schema": {
								"properties": {
									"architecture": {
										"description": "Device CPU architecture",
										"example": "x86",
										"type": "string"
									},
									"bitness": {
										"description": "CPU bitness",
										"example": "64",
										"type": "string"
									},
									"brands": {
										"description": "User agent brands data",
										"example": [
											{
												"brand": "Not/A)Brand",
												"version": "99"
											},
											{
												"brand": "Chromium",
												"version": "100"
											},
											{
												"brand": "Google Chrome",
												"version": "100"
											}
										],
										"type": "object"
									},
									"fullVersionList": {
										"description": "Detailed full version list of user agent brands",
										"example": [
											{
												"brand": "Not/A)Brand",
												"version": "99.0.0.0"
											},
											{
												"brand": "Chromium",
												"version": "100.0.4896.75"
											},
											{
												"brand": "Google Chrome",
												"version": "100.0.4896.75"
											}
										],
										"type": "object"
									},
									"mobile": {
										"description": "Whether the device is mobile",
										"example": false,
										"type": "boolean"
									},
									"model": {
										"description": "Device model name",
										"example": "OnePlus 9",
										"type": "string"
									},
									"platform": {
										"description": "Device platform name",
										"example": "Windows",
										"type": "string"
									},
									"platformVersion": {
										"description": "Platform version",
										"example": "10.0.0",
										"type": "string"
									},
									"token": {
										"default": "",
										"description": "CSRF token",
										"example": "+\\",
										"type": "string"
									},
									"uaFullVersion": {
										"description": "Deprecated full user agent version string",
										"example": "100.0.4896.75",
										"type": "string"
									}
								},
								"type": "object"
							}
						}
					},
					"description": "Request body containing client hints data",
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"description": "Response indicating successful storage of client hints",
									"example": {
										"value": "stored"
									},
									"properties": {
										"value": {
											"description": "Message explaining that the client hints were stored successfully",
											"type": "string"
										}
									},
									"required": [
										"value"
									],
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				],
				"summary": "Create user agent client hints"
			}
		},
		"/userinfo": {
			"post": {
				"description": "Returns information about public and restricted user activity.",
				"operationId": "postGetUserInformationForUserinfocard",
				"parameters": [],
				"requestBody": {
					"content": {
						"application/json": {
							"example": {
								"openedFrom": "rc",
								"sourcePage": "Special:RecentChanges",
								"token": "+\\",
								"username": "ExampleUser"
							},
							"schema": {
								"properties": {
									"openedFrom": {
										"description": "Type of the place which the UserInfoCard is opened from",
										"example": "rc",
										"type": "string"
									},
									"sourcePage": {
										"description": "Prefixed title of the page which the UserInfoCard is opened from",
										"example": "Special:RecentChanges",
										"type": "string"
									},
									"token": {
										"default": "",
										"description": "CSRF token",
										"example": "+\\",
										"type": "string"
									},
									"username": {
										"description": "Username to retrieve details for",
										"example": "ExampleUser",
										"type": "string"
									}
								},
								"required": [
									"username"
								],
								"type": "object"
							}
						}
					},
					"description": "Request body to retrieve information for the UserInfoCard",
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"description": "Response containing detailed public and restricted user activity data",
									"example": {
										"abuseFilterHitCount": 3,
										"activeBlocksOnLocalWiki": 0,
										"activeLocalBlocksAllWikis": 0,
										"activeWikis": {
											"enwiki": "https://en.wikipedia.org/wiki/Special:Contributions/ExampleUser"
										},
										"canAccessTemporaryAccountIpAddresses": false,
										"checkUserChecks": 5,
										"checkUserLastCheck": "20260610000000",
										"firstRegistration": "20200101000000",
										"gender": "unknown",
										"globalEditCount": 45000,
										"globalGroups": "<strong>Global groups</strong>: steward",
										"globalRestrictions": null,
										"globalRestrictionsTimestamp": null,
										"groups": "<strong>Groups</strong>: sysop",
										"hasCheckUserData": true,
										"hasLocalBlockGlobalBlockOrLock": false,
										"localRegistration": "20200101000000",
										"name": "ExampleUser",
										"pastBlocksOnLocalWiki": 2,
										"specialCentralAuthUrl": "https://meta.wikimedia.org/wiki/Special:CentralAuth/ExampleUser",
										"suggestedInvestigationsCaseCount": 2,
										"tempAccountsOnIPCount": [
											0,
											0
										],
										"totalEditCount": 12500,
										"userPageIsKnown": true
									},
									"properties": {
										"abuseFilterHitCount": {
											"description": "Number of abuse filter log entries triggered by this user. Only present for temporary accounts and accounts that are not autoconfirmed",
											"type": "integer"
										},
										"activeBlocksOnLocalWiki": {
											"description": "Number of active blocks on the local wiki",
											"type": "integer"
										},
										"activeLocalBlocksAllWikis": {
											"description": "Total number of active local blocks across all wikis",
											"type": "integer"
										},
										"activeWikis": {
											"description": "Map between wikis where the user has edit activity and corresponding contributions page URLs",
											"type": "object"
										},
										"canAccessTemporaryAccountIpAddresses": {
											"description": "Whether the performer can access temporary account IP addresses for the user",
											"type": "boolean"
										},
										"checkUserChecks": {
											"description": "Number of CheckUser checks performed on this user",
											"type": "integer"
										},
										"checkUserLastCheck": {
											"description": "Timestamp of the most recent CheckUser check performed on this user",
											"type": "string"
										},
										"firstRegistration": {
											"description": "First registration timestamp of the user across all wikis",
											"nullable": true,
											"type": "string"
										},
										"gender": {
											"description": "Gender of the user",
											"type": "string"
										},
										"globalEditCount": {
											"description": "Total global edit count of the user",
											"type": "integer"
										},
										"globalGroups": {
											"description": "Formatted HTML list of global user groups",
											"type": "string"
										},
										"globalRestrictions": {
											"description": "Global restriction status (e.g., locked, blocked)",
											"nullable": true,
											"type": "string"
										},
										"globalRestrictionsTimestamp": {
											"description": "Timestamp when the global restriction was applied",
											"nullable": true,
											"type": "string"
										},
										"groups": {
											"description": "Formatted HTML list of local user groups",
											"type": "string"
										},
										"hasCheckUserData": {
											"description": "Whether the user has any activity recorded in the CheckUser tables on this wiki. Only present if the performer has the checkuser right",
											"type": "boolean"
										},
										"hasLocalBlockGlobalBlockOrLock": {
											"description": "Whether the user is currently indefinitely blocked locally or globally, or locked",
											"type": "boolean"
										},
										"localRegistration": {
											"description": "Local registration timestamp of the user",
											"nullable": true,
											"type": "string"
										},
										"name": {
											"description": "Username of the user",
											"type": "string"
										},
										"pastBlocksOnLocalWiki": {
											"description": "Number of past blocks on the local wiki",
											"type": "integer"
										},
										"specialCentralAuthUrl": {
											"description": "URL to the Special:CentralAuth page for the user",
											"nullable": true,
											"type": "string"
										},
										"suggestedInvestigationsCaseCount": {
											"description": "Number of suggested investigation cases associated with this user",
											"type": "integer"
										},
										"tempAccountsOnIPCount": {
											"description": "List of two integers [min, max] representing the range of active temporary account counts on any IP address used by the user",
											"items": {
												"type": "integer"
											},
											"type": "array"
										},
										"totalEditCount": {
											"description": "Total local edit count of the user",
											"type": "integer"
										},
										"userPageIsKnown": {
											"description": "Whether the user page exists",
											"type": "boolean"
										}
									},
									"required": [
										"name",
										"gender",
										"localRegistration",
										"firstRegistration",
										"userPageIsKnown",
										"hasLocalBlockGlobalBlockOrLock",
										"groups",
										"totalEditCount",
										"activeWikis"
									],
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				],
				"summary": "Get user information for UserInfoCard"
			}
		},
		"/userinfo/blocked/{name}": {
			"get": {
				"description": "Returns local and global block and lock status of a user.",
				"operationId": "getGetUserBlockStatus",
				"parameters": [
					{
						"description": "Username for whom to query the block or lock status",
						"example": "ExampleUser",
						"in": "path",
						"name": "name",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"description": "Response containing status indicator of user block or lock",
									"example": {
										"shouldShowBlockedIcon": false
									},
									"properties": {
										"shouldShowBlockedIcon": {
											"description": "Whether the user is indefinitely blocked locally or globally, or locked",
											"type": "boolean"
										}
									},
									"required": [
										"shouldShowBlockedIcon"
									],
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				],
				"summary": "Get user block status"
			}
		}
	},
	"servers": [
		{
			"url": "https://www.mediawiki.org/w/rest.php/checkuser/v0"
		}
	]
}
