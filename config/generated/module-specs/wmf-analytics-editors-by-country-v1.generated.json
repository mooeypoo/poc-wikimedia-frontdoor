{
	"basePath": "/api/rest_v1/metrics",
	"definitions": {
		"entities.Country": {
			"properties": {
				"country": {
					"description": "Country code in ISO 3166-1 alpha-2 format",
					"example": "US",
					"type": "string"
				},
				"editors-ceil": {
					"description": "Approximate number of editors",
					"example": 2000,
					"type": "integer"
				}
			},
			"type": "object"
		},
		"entities.EditorsByCountry": {
			"properties": {
				"activity-level": {
					"description": "Editor activity range",
					"example": "5..99-edits",
					"type": "string"
				},
				"countries": {
					"description": "Number of editors per country",
					"items": {
						"$ref": "#/definitions/entities.Country"
					},
					"type": "array"
				},
				"month": {
					"description": "Month in MM format",
