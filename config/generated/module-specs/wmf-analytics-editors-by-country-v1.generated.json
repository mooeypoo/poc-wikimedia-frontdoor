					"type": "string"
				},
				"project": {
					"description": "Wikimedia project domain and subdomain",
					"example": "en.wikipedia",
					"type": "string"
				},
				"year": {
					"description": "Year in YYYY format",
					"example": "2023",
					"type": "string"
				}
			},
			"type": "object"
		},
		"entities.EditorsByCountryResponse": {
			"properties": {
