	"host": "wikimedia.org",
	"info": {
		"contact": {},
		"description": "Geo Analytics provides data about editors of Wikimedia projects by country.\nData provided by this API is available under the [CC0 1.0 license](https://creativecommons.org/publicdomain/zero/1.0/).",
		"termsOfService": "https://foundation.wikimedia.org/wiki/Special:MyLanguage/Policy:Terms_of_Use",
		"title": "Wikimedia Geo Analytics",
		"version": "1"
	},
	"paths": {
		"/editors/by-country/{project}/{activity-level}/{year}/{month}": {
			"get": {
				"description": "Returns the approximate number of editors of a Wikimedia project, split by country of origin.",
				"parameters": [
					{
						"description": "Domain and subdomain of a Wikimedia project",
						"example": "en.wikipedia.org",
						"in": "path",
						"name": "project",
						"required": true,
						"type": "string"
					},
					{
						"description": "Editor activity range",
						"enum": [
							"5..99-edits",
							"100..-edits"
						],
						"example": "5..99-edits",
						"in": "path",
						"name": "activity-level",
						"required": true,
						"type": "string"
					},
					{
						"description": "Year in YYYY format",
						"example": "2023",
						"in": "path",
						"name": "year",
						"required": true,
						"type": "string"
					},
					{
						"description": "Month in MM format",
						"example": "01",
						"in": "path",
						"name": "month",
						"required": true,
						"type": "string"
					}
				],
				"produces": [
