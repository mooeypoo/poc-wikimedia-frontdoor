		"/gitlab/tag": {
			"post": {
				"description": "A GitLab webhook handler for the tag event. See [the GitLab documentation](https://docs.gitlab.com/user/project/integrations/webhook_events/#tag-events).",
				"operationId": "postGitlabTag",
				"parameters": [],
				"requestBody": {
					"content": {
						"application/json": {
							"example": {
								"event_name": "tag_push",
								"object_kind": "tag_push",
								"project": {
									"web_url": "http://example.com/jsmith/example"
								},
								"ref": "refs/tags/v1.0.0"
							},
							"schema": {
								"properties": {
									"event_name": {
										"description": "event_name parameter",
										"enum": [
											"tag_push"
										],
										"example": "tag_push",
										"type": "string"
									},
									"object_kind": {
										"description": "object_kind parameter",
										"enum": [
											"tag_push"
										],
										"example": "tag_push",
										"type": "string"
									},
									"project": {
										"description": "project parameter",
										"example": {
											"web_url": "http://example.com/jsmith/example"
										},
										"properties": {
											"web_url": {
												"type": "string"
											}
										},
										"required": [
											"web_url"
										],
										"type": "object"
									},
									"ref": {
										"description": "ref parameter",
										"example": "refs/tags/v1.0.0",
										"type": "string"
									}
								},
								"required": [
									"object_kind",
									"event_name",
									"ref"
								],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"202": {
						"description": "Accepted"
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				]
			}
		},
		"/packages/all/": {
			"get": {
				"description": "The index to a list of all fetched package versions.",
				"operationId": "getPackagesAll",
				"parameters": [],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"partitions": {
											"items": {
												"properties": {
													"end": {
														"description": "The highest possible package ID in the partition",
														"example": 999,
														"type": "integer"
													},
													"href": {
														"description": "The relative URL of the partition; the partition parameter to the list endpoint",
														"example": "0",
														"type": "string"
													},
													"start": {
														"description": "The lowest possible package ID in the partition",
														"example": 0,
														"type": "integer"
													}
												},
												"type": "object"
											},
											"type": "array"
										}
									},
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				]
			}
		},
		"/packages/all/{partition}": {
			"get": {
				"description": "A list of fetched package versions within a partition.",
				"operationId": "getPackagesAllByPartition",
				"parameters": [
					{
						"description": "The partition number",
						"in": "path",
						"name": "partition",
						"required": true,
						"schema": {
							"type": "integer"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"packages": {
											"description": "A list of all fetched package versions in the partition",
											"items": {
												"properties": {
													"authors": {
														"description": "The package's authors.",
														"example": [
															"C. Scott Ananian",
															"Subramanya Sastry",
															"Tim Starling"
														],
														"items": {
															"type": "string"
														},
														"type": "array"
													},
													"collabUrl": {
														"description": "The URL of a human-readable entry point for source code review and contributions. For example, a GitLab project page.",
														"example": "https://gitlab.wikimedia.org/tstarling/produnto-test",
														"type": "string"
													},
													"description": {
														"additionalProperties": {
															"type": "string"
														},
														"description": "A short localised description of the package.",
														"example": {
															"en": "A test package for testing the package manager."
														},
														"type": "object"
													},
													"docUrl": {
														"description": "The URL of the documentation page.",
														"example": "https://www.mediawiki.org/wiki/Extension:Produnto",
														"type": "string"
													},
													"errors": {
														"description": "Errors which occurred while fetching the package and parsing its manifest file",
														"items": {
															"properties": {
																"key": {
																	"description": "The MediaWiki message key",
																	"example": "produnto-fetch-manifest",
																	"type": "string"
																},
																"translations": {
																	"additionalProperties": {
																		"description": "The string in each language",
																		"type": "string"
																	},
																	"description": "An array mapping the MediaWiki language code to the translation in that language.",
																	"example": {
																		"en": "Error in produnto.json: invalid JSON"
																	},
																	"required": [
