{
	"components": {
		"responses": {
			"GenericErrorResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/GenericErrorResponseModel"
						}
					}
				},
				"description": "Generic error response"
			}
		},
		"schemas": {
			"array-param": {
				"type": "object"
			},
			"boolean-param": {
				"type": "boolean"
			},
			"double-param": {
				"format": "double",
				"type": "number"
			},
			"enum-param": {
				"type": "string"
			},
			"expiry-param": {
				"format": "mw-expiry",
				"type": "string"
			},
			"float-param": {
				"format": "float",
				"type": "number"
			},
			"GenericErrorResponseModel": {
				"description": "Generic error response. The message will provide more details about the error.",
				"properties": {
					"httpCode": {
						"description": "The HTTP status code of the error response.",
						"example": 500,
						"type": "integer"
					},
					"httpMessage": {
						"description": "The HTTP status message of the error response.",
						"example": "Internal Server Error",
						"type": "string"
					},
					"message": {
						"description": "A human-readable error message, useful when no message translations are available",
						"example": "An unexpected error occurred",
						"type": "string"
					},
					"messageTranslations": {
						"additionalProperties": {
							"type": "string"
						},
						"description": "A map of language codes to human-readable error messages, for clients that can use them.",
						"example": {
							"en": "An unexpected error occurred",
							"es": "Ocurrió un error inesperado"
						},
						"type": "object"
					}
				},
				"required": [
					"httpCode"
				]
			},
			"integer-param": {
				"type": "integer"
			},
			"namespace-param": {
				"type": "integer"
			},
			"password-param": {
				"type": "string"
			},
			"string-param": {
				"type": "string"
			},
			"timestamp-param": {
				"format": "mw-timestamp",
				"type": "string"
			},
			"title-param": {
				"format": "mw-title",
				"type": "string"
			},
			"upload-param": {
				"format": "mw-upload",
				"type": "string"
			},
			"user-param": {
				"format": "mw-user",
				"type": "string"
			}
		},
		"securitySchemes": {
			"CentralAuthSessionProvider-Session": {
				"description": "MediaWiki Session ID cookie.\nNote: Write operations using this method also require a CSRF token to be submitted in the request body.",
				"in": "cookie",
				"name": "testwikiSession",
				"type": "apiKey"
			},
			"CentralAuthSessionProvider-Token": {
				"description": "MediaWiki User Token cookie.\nRequired for persistent session verification.",
				"in": "cookie",
				"name": "testwikiToken",
				"type": "apiKey"
			},
			"CentralAuthSessionProvider-UserID": {
				"description": "MediaWiki User ID cookie.\nRequired alongside the session ID.",
				"in": "cookie",
				"name": "testwikiUserID",
				"type": "apiKey"
			}
		}
	},
	"info": {
		"contact": {
			"email": "noc@wikipedia.org",
			"name": "Wikipedia",
			"url": "https://test.wikipedia.org"
		},
		"description": "API for the Produnto package manager\n\nCaution: The REST Sandbox executes calls against the production database by default. To avoid unintended edits to live content, select the sandbox server (test.wikimedia.org) from the server dropdown before making POST, PUT, PATCH, or DELETE requests.",
		"license": {
			"name": "Creative Commons Attribution-Share Alike 4.0",
			"url": "https://creativecommons.org/licenses/by-sa/4.0/deed.test"
		},
		"termsOfService": "https://foundation.wikimedia.org/wiki/Policy:Terms_of_Use#12._API_Terms",
		"title": "Produnto API",
		"version": "1.0.0"
	},
	"openapi": "3.0.0",
	"paths": {
		"/deployment/patch": {
			"post": {
				"description": "Make changes to the deployed set of package versions.",
				"operationId": "postDeploymentPatch",
				"parameters": [],
				"requestBody": {
					"content": {
						"application/x-www-form-urlencoded": {
							"schema": {
								"properties": {
									"ignoreWarnings": {
										"description": "Whether to ignore validation warnings, such as package requirements not satisfied.",
										"type": "boolean"
									},
									"packages": {
										"description": "JSON serialized object mapping package names to versions. If a deployed package is absent, it will remain unchanged. If a version is null or the empty string, that package will be undeployed.",
										"example": "{\"some-package\":\"1.0\"}",
										"type": "string"
									},
									"summary": {
										"description": "A comment for the revision.",
										"example": "Updated some-package from 1.0 to 2.0",
										"type": "string"
									},
									"token": {
										"default": "",
										"description": "CSRF token.\n**Required** if authenticating via the MediaWiki-Session-CookieSessionProvider cookies.\n**Not required** if using a CSRF-safe mechanism, such as OAuth2.0.",
										"type": "string"
									}
								},
								"required": [
									"packages"
								],
								"type": "object"
							}
						},
						"multipart/form-data": {
							"schema": {
								"properties": {
									"ignoreWarnings": {
										"description": "Whether to ignore validation warnings, such as package requirements not satisfied.",
										"type": "boolean"
									},
									"packages": {
										"description": "JSON serialized object mapping package names to versions. If a deployed package is absent, it will remain unchanged. If a version is null or the empty string, that package will be undeployed.",
										"example": "{\"some-package\":\"1.0\"}",
										"type": "string"
									},
									"summary": {
										"description": "A comment for the revision.",
										"example": "Updated some-package from 1.0 to 2.0",
										"type": "string"
									},
									"token": {
										"default": "",
										"description": "CSRF token.\n**Required** if authenticating via the MediaWiki-Session-CookieSessionProvider cookies.\n**Not required** if using a CSRF-safe mechanism, such as OAuth2.0.",
										"type": "string"
									}
								},
								"required": [
									"packages"
								],
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"deployment": {
											"properties": {
												"active": {
													"description": "Whether the deployment is active by default on the wiki.",
													"type": "boolean"
												},
												"controlWiki": {
													"description": "The wiki ID of the initiating action.",
													"example": "enwiki",
													"type": "string"
												},
												"id": {
													"description": "The ID of the deployment, pd_id.",
													"example": 1,
													"type": "integer"
												},
												"packages": {
													"additionalProperties": {
														"type": "string"
													},
													"description": "Map of package name to deployed version.",
													"example": {
														"some-package": "1.0"
													},
													"type": "object"
												},
												"revision": {
													"description": "The revision ID of the initiating action.",
													"example": 1,
													"type": "integer"
												},
												"summary": {
													"description": "The edit summary or comment supplied by the initiating user.",
													"example": "Updated some-package from 1.0 to 2.0",
													"type": "string"
												},
												"timestamp": {
													"description": "The ISO-8601 combined date and time of when the deployment was created.",
													"example": "2026-07-16T05:22:29Z",
													"type": "string"
												},
												"userText": {
													"description": "The name of the initiating user.",
													"example": "Some user",
													"type": "string"
												}
											},
											"required": [
												"id"
											],
											"type": "object"
										},
										"errors": {
											"description": "Fatal errors",
											"items": {
												"properties": {
													"key": {
														"description": "The MediaWiki message key",
														"example": "produnto-fetch-manifest",
														"type": "string"
													},
													"translations": {
														"additionalProperties": {
															"description": "The string in each language",
															"type": "string"
														},
														"description": "An array mapping the MediaWiki language code to the translation in that language.",
														"example": {
															"en": "Error in produnto.json: invalid JSON"
														},
														"required": [
															"en"
														],
														"type": "object"
													}
												},
												"type": "object"
											},
											"type": "array"
										},
										"ok": {
											"description": "Whether the deployment was successful",
											"type": "boolean"
										},
										"warnings": {
											"description": "Validation warnings",
											"items": {
												"properties": {
													"key": {
														"description": "The MediaWiki message key",
														"example": "produnto-fetch-manifest",
														"type": "string"
													},
													"translations": {
														"additionalProperties": {
															"description": "The string in each language",
															"type": "string"
														},
														"description": "An array mapping the MediaWiki language code to the translation in that language.",
														"example": {
															"en": "Error in produnto.json: invalid JSON"
														},
														"required": [
															"en"
														],
														"type": "object"
													}
												},
												"type": "object"
											},
											"type": "array"
										}
									},
									"required": [
										"ok"
									],
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				]
			}
		},
		"/deployment/validate": {
			"post": {
				"description": "Validate a proposed new set of package versions.",
				"operationId": "postDeploymentValidate",
				"parameters": [],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"additionalProperties": {
									"type": "string"
								},
								"description": {},
								"example": {
									"some-package": "1.0"
								},
								"type": "object"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"errors": {
											"description": "An array of errors.",
											"items": {
												"properties": {
													"key": {
														"description": "The MediaWiki message key",
														"example": "produnto-fetch-manifest",
														"type": "string"
													},
													"translations": {
														"additionalProperties": {
															"description": "The string in each language",
															"type": "string"
														},
														"description": "An array mapping the MediaWiki language code to the translation in that language.",
														"example": {
															"en": "Error in produnto.json: invalid JSON"
														},
														"required": [
															"en"
														],
														"type": "object"
													}
												},
												"type": "object"
											},
											"type": "array"
										},
										"ok": {
											"description": "This will be true if there were no errors, even if there were warnings. Warnings are significant and need to be acknowledged by the user before deployment.",
											"type": "boolean"
										},
										"warnings": {
											"description": "An array of warnings. This should be empty before proceeding with an automated deployment.",
											"items": {
												"properties": {
													"key": {
														"description": "The MediaWiki message key",
														"example": "produnto-fetch-manifest",
														"type": "string"
													},
													"translations": {
														"additionalProperties": {
															"description": "The string in each language",
															"type": "string"
														},
														"description": "An array mapping the MediaWiki language code to the translation in that language.",
														"example": {
															"en": "Error in produnto.json: invalid JSON"
														},
														"required": [
															"en"
														],
														"type": "object"
													}
												},
												"type": "object"
											},
											"type": "array"
										}
									},
									"type": "object"
								}
							}
						},
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				]
			}
		},
		"/deployments/recent": {
			"get": {
				"description": "Get a list of recent deployments, including the active deployment if any.",
				"operationId": "getDeploymentsRecent",
				"parameters": [],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"deployments": {
											"items": {
												"properties": {
													"active": {
														"description": "Whether the deployment is active by default on the wiki.",
														"type": "boolean"
													},
													"controlWiki": {
														"description": "The wiki ID of the initiating action.",
														"example": "enwiki",
														"type": "string"
													},
													"id": {
														"description": "The ID of the deployment, pd_id.",
														"example": 1,
														"type": "integer"
													},
													"packages": {
														"additionalProperties": {
															"type": "string"
														},
														"description": "Map of package name to deployed version.",
														"example": {
															"some-package": "1.0"
														},
														"type": "object"
													},
													"revision": {
														"description": "The revision ID of the initiating action.",
														"example": 1,
														"type": "integer"
													},
													"summary": {
														"description": "The edit summary or comment supplied by the initiating user.",
														"example": "Updated some-package from 1.0 to 2.0",
														"type": "string"
													},
													"timestamp": {
														"description": "The ISO-8601 combined date and time of when the deployment was created.",
														"example": "2026-07-16T05:22:29Z",
														"type": "string"
													},
													"userText": {
