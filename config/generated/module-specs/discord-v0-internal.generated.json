{
	"components": {
		"responses": {
			"GenericErrorResponse": {
				"content": {
					"application/json": {
						"schema": {
							"$ref": "#/components/schemas/GenericErrorResponseModel"
						}
					}
				},
				"description": "Generic error response"
			}
		},
		"schemas": {
			"array-param": {
				"type": "object"
			},
			"boolean-param": {
				"type": "boolean"
			},
			"double-param": {
				"format": "double",
				"type": "number"
			},
			"enum-param": {
				"type": "string"
			},
			"expiry-param": {
				"format": "mw-expiry",
				"type": "string"
			},
			"float-param": {
				"format": "float",
				"type": "number"
			},
			"GenericErrorResponseModel": {
				"description": "Generic error response. The message will provide more details about the error.",
				"properties": {
					"httpCode": {
						"description": "The HTTP status code of the error response.",
						"example": 500,
						"type": "integer"
					},
					"httpMessage": {
						"description": "The HTTP status message of the error response.",
						"example": "Internal Server Error",
						"type": "string"
					},
					"message": {
						"description": "A human-readable error message, useful when no message translations are available",
						"example": "An unexpected error occurred",
						"type": "string"
					},
					"messageTranslations": {
						"additionalProperties": {
							"type": "string"
						},
						"description": "A map of language codes to human-readable error messages, for clients that can use them.",
						"example": {
							"en": "An unexpected error occurred",
							"es": "Ocurrió un error inesperado"
						},
						"type": "object"
					}
				},
				"required": [
					"httpCode"
				]
			},
			"integer-param": {
				"type": "integer"
			},
			"namespace-param": {
				"type": "integer"
			},
			"password-param": {
				"type": "string"
			},
			"string-param": {
				"type": "string"
			},
			"timestamp-param": {
				"format": "mw-timestamp",
				"type": "string"
			},
			"title-param": {
				"format": "mw-title",
				"type": "string"
			},
			"upload-param": {
				"format": "mw-upload",
				"type": "string"
			},
			"user-param": {
				"format": "mw-user",
				"type": "string"
			}
		},
		"securitySchemes": {
			"CentralAuthSessionProvider-Session": {
				"description": "MediaWiki Session ID cookie.\nNote: Write operations using this method also require a CSRF token to be submitted in the request body.",
				"in": "cookie",
				"name": "mediawikiwikiSession",
				"type": "apiKey"
			},
			"CentralAuthSessionProvider-Token": {
				"description": "MediaWiki User Token cookie.\nRequired for persistent session verification.",
				"in": "cookie",
				"name": "mediawikiwikiToken",
				"type": "apiKey"
			},
			"CentralAuthSessionProvider-UserID": {
				"description": "MediaWiki User ID cookie.\nRequired alongside the session ID.",
				"in": "cookie",
				"name": "mediawikiwikiUserID",
				"type": "apiKey"
			}
		}
	},
	"externalDocs": {
		"description": "Discord preview project page",
		"url": "https://meta.wikimedia.org/wiki/Future_Audiences/Discord_previews"
	},
	"info": {
		"contact": {
			"name": "Future Audiences Team",
			"url": "https://www.mediawiki.org/wiki/Talk:Future_Audiences"
		},
		"license": {
			"name": "Creative Commons Attribution-Share Alike 4.0",
			"url": "https://creativecommons.org/licenses/by-sa/4.0/"
		},
		"termsOfService": "https://foundation.wikimedia.org/wiki/Policy:Terms_of_Use#12._API_Terms",
		"title": "Discord Preview API",
		"version": "0.1.0-internal"
	},
	"openapi": "3.0.0",
	"paths": {
		"/discord-preview": {
			"get": {
				"operationId": "getDiscordPreview",
				"parameters": [
					{
						"description": "title parameter",
						"in": "query",
						"name": "title",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"headers": {
							"Cache-Control": {
								"description": "Dictates caching behavior for a browser, letting it know how often to refresh locally stored resources.",
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/GenericErrorResponse"
					}
				},
				"security": [
					{
						"CentralAuthSessionProvider-Session": [],
						"CentralAuthSessionProvider-Token": [],
						"CentralAuthSessionProvider-UserID": []
					}
				]
			}
		}
	},
	"servers": [
		{
			"url": "https://www.mediawiki.org/w/rest.php/discord/v0-internal"
		}
	]
}
