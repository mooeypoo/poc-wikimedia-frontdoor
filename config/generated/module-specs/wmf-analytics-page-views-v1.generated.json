						"required": true,
						"type": "string"
					},
					{
						"description": "Method of access",
						"enum": [
							"all-access",
							"desktop",
							"mobile-app",
							"mobile-web"
						],
						"example": "all-access",
						"in": "path",
						"name": "access",
						"required": true,
						"type": "string"
					},
					{
						"description": "Type of user agent",
