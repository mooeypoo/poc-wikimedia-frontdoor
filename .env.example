# Wikimedia OAuth 2.0 (docs/adr-wikimedia-oauth-authentication.md).
# Copy this file to .env and fill in real values. Never commit .env.

# 32-byte secret used to encrypt the transient PKCE handshake cookie (h3.useSession).
# Generate one with: openssl rand -base64 32
NUXT_OAUTH_COOKIE_SECRET=

# client_id from the approved Wikimedia OAuth 2.0 consumer registration
# (https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2).
# The consumer's callback URL must exactly match your origin + /oauth/callback.
NUXT_PUBLIC_OAUTH_CLIENT_ID=

# Absolute public origin, no trailing slash. Used for the absolute URLs in
# /sitemap.xml, /llms.txt and /llms-full.txt, and for the Sitemap: line in
# /robots.txt (config/seo.ts).
#
# Leave it unset for local work: outside a production build the origin falls back
# to http://localhost:3000, so those documents are testable with no setup. On
# Netlify it is unnecessary too — DEPLOY_PRIME_URL is picked up automatically and
# is preferred over URL, so deploy previews describe themselves rather than
# production. Set this explicitly only to override both.
#
# A production build with no origin from any source deliberately SKIPS the
# sitemap and llms files (with a build warning) rather than publish guessed
# addresses that crawlers would act on.
# NUXT_PUBLIC_SITE_URL=https://developer.wikimedia.org
