{
  "name": "frontdoor",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nuxt build",
    "build:netlify": "NITRO_PRESET=netlify nuxt build",
    "dev": "nuxt dev",
    "dev:clean": "rm -rf node_modules/.cache/vite .nuxt && nuxt dev",
    "fetch-remote-content": "node scripts/fetch-remote-content.mjs",
    "generate-content-i18n": "node packages/banana-content/src/node/cli.js",
    "generate-content-i18n-stubs": "node scripts/generate-content-stub-translations.mjs",
    "test:banana-content": "npm test --workspace @wikimedia/banana-content",
    "generate-scalar-localization": "node scripts/generate-scalar-localization.mjs",
    "seed-scalar-localization": "node scripts/seed-scalar-localization.mjs",
    "generate-language-catalog": "node scripts/generate-language-catalog.mjs",
    "generate-module-source-of-truth": "node scripts/generate-module-source-of-truth.mjs",
    "lint": "npm run lint:eslint && npm run lint:typecheck",
    "lint:eslint": "nuxt prepare && eslint .",
    "lint:fix": "nuxt prepare && eslint . --fix",
    "lint:typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "generate:static": "nuxt generate",
    "preview": "nuxt preview",
    "test:content-fallback": "node scripts/test-content-fallback.mjs"
  },
  "dependencies": {
    "@netlify/functions": "^5.2.2",
    "@nuxt/content": "^3.13.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@scalar/api-reference": "^1.67.0",
    "@wikimedia/codex": "^2.5.1",
    "@wikimedia/codex-design-tokens": "^2.5.1",
    "banana-i18n": "^2.4.0",
    "better-sqlite3": "^12.10.0",
    "markdown-it": "^14.1.0",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "sqlite3": "^6.0.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.10.0",
    "oxc-parser": "^0.131.0",
    "rolldown": "^1.0.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "22.x"
  }
}
